import importlib.util  # 导入 importlib.util 模块，用于检查某个模块是否安装
from dataclasses import dataclass  # 导入 dataclass，用于快速定义数据类

if importlib.util.find_spec("langchain_text_splitters") is not None:  # 如果 langchain_text_splitters 已安装
    from langchain_text_splitters import CharacterTextSplitter  # 直接导入官方的 CharacterTextSplitter
else:  # 否则执行兜底方案，自己定义一个简化版
    @dataclass  # 给 Document 类自动生成 __init__ 等常用方法
    class Document:
        page_content: str  # 文档内容字段，类型为字符串

    class CharacterTextSplitter:  # 定义一个简化版文本切分器，用于缺失依赖时仍可运行
        def __init__(self, separator=" ", chunk_size=100, chunk_overlap=20, length_function=len):  # 初始化切分器参数
            self.separator = separator  # 保存分隔符，默认按空格切分
            self.chunk_size = chunk_size  # 保存每个块的最大长度
            self.chunk_overlap = chunk_overlap  # 保存相邻块之间的重叠长度
            self.length_function = length_function  # 保存长度计算函数，默认用 len

        def _split_text(self, text):  # 定义私有方法，负责把长文本拆成多个片段
            parts = [part.strip() for part in text.split(self.separator) if part.strip()]  # 用分隔符切分文本，并过滤空字符串
            chunks = []  # 用于保存所有切分好的文本块
            current = []  # 当前正在构建的文本块
            current_len = 0  # 当前块的长度

            for part in parts:  # 遍历每一段分词/片段
                candidate = part if not current else f"{self.separator}{part}"  # 计算这次加入后可能的字符串形式
                proposed_len = self.length_function(self.separator.join(current + [part]))  # 评估加入当前片段后，当前块将达到多大长度

                if current and proposed_len > self.chunk_size:  # 如果当前块已有内容，且继续加入会超出最大长度
                    chunks.append(self.separator.join(current))  # 把当前块保存进去
                    current = current[-max(1, self.chunk_overlap // 2):]  # 保留尾部一部分作为重叠内容
                    current_len = self.length_function(self.separator.join(current))  # 更新重叠后的长度
                current.append(part)  # 把当前片段加入到当前块中
                current_len = self.length_function(self.separator.join(current))  # 更新当前块长度

            if current:  # 如果循环结束后仍有未保存的内容
                chunks.append(self.separator.join(current))  # 把最后一个块追加到结果中
            return chunks  # 返回所有切分后的文本块

        def create_documents(self, texts):  # 把输入的多个文本块转换成 Document 对象列表
            documents = []  # 用于保存生成的文档对象
            for text in texts:  # 遍历每一段原始文本
                for chunk in self._split_text(text):  # 对每一段文本进行切分
                    documents.append(Document(page_content=chunk))  # 创建一个 Document，并保存该切分片段内容
            return documents  # 返回文档列表

