text_splitter = CharacterTextSplitter(  # 创建一个文本切分器实例，并配置参数
    separator=" ",  # 以空格为分隔符进行切分
    chunk_size=100,  # 每个文本块最多100个字符
    chunk_overlap=20,  # 相邻文本块重叠20个字符
